# Path to config.json (token, clientId, bugsnagKey, environment).
# In the container this defaults to /data/config.json.
BOT_CONFIG="../config.json"

# Local SQLite directory for per-server settings (ignored by git).
# In the container this is always /data (the mounted volume).
# STANCY_DATA_DIR=./data

# Optional. When set, slash commands register to this guild (instant updates).
# Leave unset in production to register commands globally.
# If config.environment is "development" and this is unset, Stancy still uses
# the historical GWJ test guild (545109131330191371).
# DEV_GUILD_ID=545109131330191371