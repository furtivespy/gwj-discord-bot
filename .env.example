# Copy this file to `.env`. Secrets are not in this file — they live in the
# JSON named by BOT_CONFIG (copy config.json.sample → config.json).
#
# config.json keys the bot reads:
#   token          Discord bot token (required)
#   clientId       Discord application id (required)
#   environment    "development" or "production" (required)
#   bugsnagKey     optional Bugsnag API key; blank / "abc123" stays console-only
#   devGuildId     optional guild id for slash command registration
#   botOwnerId     optional Discord user id treated as Bot Owner
#   defaultSettings  optional { modRole, adminRole, systemNotice }

# Path to config.json (token, clientId, optional bugsnagKey, environment).
# Relative BOT_CONFIG paths are resolved from src/bot.js, so from the repo
# this is ../config.json (the file next to package.json). In the container
# this defaults to /data/config.json.
BOT_CONFIG="../config.json"

# Local SQLite directory for per-server settings (ignored by git).
# In the container this is always /data (the mounted volume).
# STANCY_DATA_DIR=./data

# Set by the Docker image. Do not set this locally —
# local runs use ./config.json and ./data; containers use the /data volume.
# IS_IN_CONTAINER=true

# Guild id for instant slash command updates. Leave blank in production to
# register globally. There is no hardcoded fallback guild — if this and
# config.devGuildId are both empty, commands register globally (slow).
DEV_GUILD_ID=

# Optional OpenTelemetry. Tracing stays off unless an OTLP endpoint is set.
# For Honeycomb: https://api.honeycomb.io/v1/traces
# and OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=YOUR_API_KEY
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=stancy-bot
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_DEBUG_SPANS=false
